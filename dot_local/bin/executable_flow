#!/usr/bin/env nu
# flow — personal dev workflow helper.
#
# This file is the single entry point. It declares `main <group> <cmd>`
# dispatchers, then delegates to modules under ~/.config/flow/cmd/*.nu.
# Shared UI helpers (gum/glow wrappers) live in ~/.config/flow/lib/ui.nu.
#
# Layout:
#   ~/.local/bin/flow           this file (Unix shebang + Windows target)
#   ~/.local/bin/flow.cmd       Windows wrapper -> `nu %~dp0flow %*`
#   ~/.config/flow/lib/ui.nu    styling / prompt primitives (gum, glow)
#   ~/.config/flow/lib/util.nu  small shared helpers
#   ~/.config/flow/cmd/git.nu   `flow git ...` impls
#   ~/.config/flow/cmd/oc.nu    `flow oc ...`  impls
#   ~/.config/flow/cmd/review.nu`flow review ...` impls
#
# Add a new command:
#   1. `export def foo [] { ... }` in cmd/<group>.nu
#   2. Add `def "main <group> foo" [] { <group>cmd foo }` below.

use ~/.config/flow/lib/ui.nu
use ~/.config/flow/cmd/chezmoi.nu
use ~/.config/flow/cmd/dev.nu
use ~/.config/flow/cmd/edit.nu
use ~/.config/flow/cmd/git.nu
use ~/.config/flow/cmd/net.nu
use ~/.config/flow/cmd/nvim.nu
use ~/.config/flow/cmd/oc.nu
use ~/.config/flow/cmd/review.nu

# Each `use X.nu` imports module `X` with its `export def`s as subcommands.
# `chezmoi update` below refers to the module export, not the external binary;
# inside chezmoi.nu itself `chezmoi update` still calls the external because
# the module doesn't `use` itself.

# -- chezmoi -----------------------------------------------------------------
def "main chezmoi origin-to-ssh" [] { chezmoi origin-to-ssh }
def "main chezmoi update" [--force] { chezmoi update --force=$force }

# -- dev ---------------------------------------------------------------------
def "main dev start" [] { dev start }

# -- edit --------------------------------------------------------------------
def "main edit zsh"  [] { edit zsh }
def "main edit nvim" [] { edit nvim }
def "main edit nu"   [] { edit nu }
def "main edit mise" [] { edit mise }

# -- git ---------------------------------------------------------------------
def "main git branch" [] { git branch }
def "main git commit" [] { git commit }
def "main git wip"    [] { git wip }

# -- net ---------------------------------------------------------------------
def "main net ip" [] { net ip }

# -- nvim --------------------------------------------------------------------
def "main nvim update" [] { nvim update }

# -- openshift ---------------------------------------------------------------
def "main oc project" [name?: string] { oc project $name }
def "main oc pods"    [] { oc pods }

# -- review ------------------------------------------------------------------
def "main review diff" [] { review diff }

# -- top-level ---------------------------------------------------------------
def main [] { ui help }
