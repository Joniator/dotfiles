[user]
{{- if not .isWork }}
  email = jboeckel@mailbox.org
{{- else }}
  email = jonathan.boeckel@msg.group
{{- end }}
  name = Jonathan Boeckel
  signingkey = ~/.ssh/id_ed25519

[alias]
  p  = push
  pmr = p --push-option=merge_request.create
  pmra = pmr --push-option=merge_request.auto_merge
  a  = add
  aa = add --all
  c  = commit
  ca = commit --amend
  cane = commit --amend --no-edit
  f  = fetch
  pl  = pull
  st = status
  from = !git fetch && git rebase origin/main
  s = !git switch \"$(git for-each-ref --format=\"%(refname:short)\" refs/heads | fzf)\"
  sc = switch -c

[gpg]
  format = ssh

[http]
  sslVerify = false

[credential "https://codeberg.org"]
  provider = generic

[credential]
  helper = cache

[color]
  ui = true

[core]
  autocrlf = {{ eq .chezmoi.os "windows" }}
  excludesFile = ~/.gitignore

[log]
  decorate      = true
  showSignature = false
  abbrevCommit  = true


# clearly makes git better

[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true

# why the hell not?

[help]
  autocorrect = prompt
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[core]
  excludesfile = ~/.gitignore
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[merge]
  conflictstyle = zdiff3
[pull]
  rebase = true

